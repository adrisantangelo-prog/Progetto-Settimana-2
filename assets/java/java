/* VERSIONE AVANZATA — renderProdotti(lista)
   Funzione che, dato un array di prodotti, genera la griglia nel DOM.
   Niente HTML hard-coded per i prodotti: tutto generato dal JavaScript.
*/

/* SCRIVI QUI LA TUA RISPOSTA */

// Funzione per generare le stelle del rating
function generaStelle(voto) {
    let stelle = "";
    for (let i = 0; i < 5; i++) {
        if (i < voto) {
            stelle += "★"; 
        } else {
            stelle += "☆"; 
        }
    }
    return stelle;
}

// Funzione principale per creare e popolare l'intera tabella
function creaTabella() {
    const container = document.getElementById("tabella-container");
    container.innerHTML = ""; // Svuota il contenitore

    // 1. Crea l'elemento tabella di base
    const tabella = document.createElement("table");
    tabella.setAttribute("border", "1");

    // 2. Crea l'intestazione della tabella (thead)
    const thead = document.createElement("thead");
    thead.innerHTML = `
        <tr>
            <th>NOME</th>
            <th>CATEGORIA</th>
            <th>PREZZO</th>
            <th>RATING</th>
        </tr>
    `;
    tabella.appendChild(thead);

    // 3. Crea il corpo della tabella (tbody) e inserisci i dati dei prodotti
    const tbody = document.createElement("tbody");
    prodotti.forEach(prodotto => {
        const riga = document.createElement("tr");

        riga.innerHTML = `
            <td>${prodotto.nome}</td>
            <td>${prodotto.categoria}</td>
            <td>€ ${prodotto.prezzo.toFixed(2)}</td>
            <td>${generaStelle(prodotto.rating)}</td>
        `;
        tbody.appendChild(riga);
    });
    tabella.appendChild(tbody);

    // 4. Crea pagina della tabella (tfoot) con il totale
    const tfoot = document.createElement("tfoot");
    tfoot.innerHTML = `
        <tr>
            <td colspan="4">Totale prodotti = ${prodotti.length}</td>
        </tr>
    `;
    tabella.appendChild(tfoot);

    // 5. Inserisce la tabella finita nel container DOM dell'HTML
    container.appendChild(tabella);
}

// Esegue la creazione della tabella al caricamento della pagina
window.onload = creaTabella;